# Data & models (never commit trained artifacts or datasets)
*.db
*.sqlite3
# Trained artifacts are derived data. The shipped injection classifier is
# committed (see models/) so a fresh clone detects attacks out of the box;
# everything else stays out.
*.joblib
!models/injection_clf.joblib
*.pkl
training/data/*
!training/data/.gitkeep
benchmark/results/*
!benchmark/results/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
