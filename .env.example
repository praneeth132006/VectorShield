# ---------------------------------------------------------------------------
# VectorShield configuration. Copy to .env and edit. Never commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------
# Dev default is SQLite. For deployment use a Postgres URL, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vectorshield
DATABASE_URL=sqlite+aiosqlite:///./vectorshield.db

# Prompt/response text is hashed by default. Set true to persist raw content.
# Blocked and sanitized requests always retain content so attacks are triageable.
STORE_CONTENT=false

# --- Rate limiting ---------------------------------------------------------
# Leave empty for the in-process limiter (single worker, zero setup).
# Set for multi-worker/production, e.g. redis://localhost:6379/0 or an Upstash URL.
REDIS_URL=
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Upstream provider -----------------------------------------------------
# ollama = free, local, offline. openai = hosted.
DEFAULT_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

UPSTREAM_TIMEOUT_SECONDS=60

# --- Security policy -------------------------------------------------------
# open   = ambiguous requests are allowed and flagged (default; protects UX)
# closed = ambiguous requests are blocked (stricter, more false positives)
FAIL_MODE=open
BLOCK_THRESHOLD=0.85
FLAG_THRESHOLD=0.45

# Gateway owns the tenant system prompt and plants a canary token in it.
INJECT_SYSTEM_PROMPT=true
CANARY_ENABLED=true

# --- Outbound scanning (LLM06) ---------------------------------------------
# Inspect model responses for secrets, personal data, and system-prompt or
# canary leakage. A confident hit redacts the offending span; a leaked canary
# withholds the whole response.
OUTBOUND_SCANNING=true
# PII is the noisiest outbound signal -- a support bot legitimately prints
# email addresses. Set false to keep only credential and canary checks.
DETECT_PII=true

# --- Resource limits / abuse hardening (LLM04) -----------------------------
# Two layers. These are hard limits, refused before any detector runs.

# Requests per minute, per API key. Sliding window.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Tokens per minute, per API key. Charged on an estimate before the call and
# reconciled against the provider's real usage afterwards. 0 disables it.
RATE_LIMIT_TOKENS_PER_MINUTE=40000

# Payload caps. Refused with 413 before the prompt is tokenized or inspected,
# because a single huge request is a cost attack that no rate limit catches.
# 0 disables a cap.
MAX_PROMPT_CHARS=48000
MAX_MESSAGES=200

# Ceiling on what a client may ask the model to generate. A request for more
# is clamped to this rather than refused -- the caller gets a shorter answer,
# not an error.
MAX_OUTPUT_TOKENS=4096
# What a reply is assumed to cost when the client names no max_tokens.
# Reserving the full ceiling instead would make the token budget bind several
# times tighter than the request limit beside it.
EXPECTED_COMPLETION_TOKENS=512

# Content-shaped DoS detection: repetition bombs, unbounded-output requests,
# absurd explicit counts. Reports findings; it does not enforce.
DETECT_RESOURCE_ABUSE=true

# --- Extraction detection (LLM10) ------------------------------------------
# Behavioral, so it compares each prompt against a bounded per-tenant history.
# State is in-process: across several workers each sees only its own slice of
# a tenant's traffic, which lowers recall but never invents a detection.
# Turn this off for a genuine batch workload rather than fighting it.
DETECT_EXTRACTION=true
EXTRACTION_WINDOW_SECONDS=600
EXTRACTION_HISTORY=256

# --- Auth ------------------------------------------------------------------
# Creates a first tenant on startup so a fresh clone is immediately usable.
BOOTSTRAP_API_KEY=vs_change_me_local_dev_key
# Required to enable /admin/tenants. Leave empty to keep the admin API disabled.
ADMIN_TOKEN=
